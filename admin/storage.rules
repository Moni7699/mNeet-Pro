rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Verify the authenticated administrator.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    // Course thumbnails
    match /courses/{courseId}/thumbnail/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Notes PDFs
    match /notes/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // NCERT PDFs
    match /ncert/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // PYQ PDFs
    match /pyq/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Quiz question images
    match /questions/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Admin profile pictures
    match /profiles/{userId}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow write: if isAdmin()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny all other files.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
