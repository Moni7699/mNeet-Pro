rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role == "admin"
        && firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.status == "active";
    }

    function approvedPurchase(courseId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/purchases/$(request.auth.uid + "_" + courseId)
        )
        && firestore.get(
          /databases/(default)/documents/purchases/$(request.auth.uid + "_" + courseId)
        ).data.status == "approved";
    }

    // ADMIN UPLOADS
    match /courses/{courseId}/{allPaths=**} {
      allow write: if admin();

      allow read: if admin()
        || (
          signedIn()
          && approvedPurchase(courseId)
        );
    }

    // Student profile photos
    match /profilePhotos/{uid}/{fileName} {
      allow read: if signedIn() && request.auth.uid == uid
        || admin();

      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if signedIn()
        && request.auth.uid == uid
        || admin();
    }

    // Payment receipts: owner and Admin only.
    match /paymentReceipts/{uid}/{fileName} {
      allow read: if admin()
        || (
          signedIn()
          && request.auth.uid == uid
        );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow update, delete: if admin();
    }

    // Deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
